{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AfriCompta+",
  "version": "3.1.0",
  "identifier": "com.wisedesign.africomptaplus",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "AfriCompta+", "url": "index.html", "width": 1200, "height": 800, "minWidth": 420, "minHeight": 600, "resizable": true, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Wise Design",
    "copyright": "© Wise Design",
    "category": "Business",
    "shortDescription": "Gestion de boutique : ventes, stock, dettes, WhatsApp",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["French", "English", "Spanish"], "displayLanguageSelector": true } }
  }
}
